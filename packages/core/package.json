{
  "name": "@team-monet/core",
  "version": "0.8.0",
  "description": "Monet — state-centric memory substrate engine.",
  "packageManager": "pnpm@10.33.2",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepare": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir src",
    "demo": "tsx scripts/demo.ts",
    "knows": "tsx scripts/knows-demo.ts",
    "eval": "tsx src/eval/run.ts",
    "embed:check": "tsx scripts/embed-check.ts",
    "mcp": "tsx scripts/mcp-cli.ts",
    "mcp:smoke": "tsx scripts/mcp-smoke.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "better-sqlite3": "^11.7.0",
    "zod": "^3.25.76"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^3.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^25.3.3",
    "tsup": "^8.5.1",
    "tsx": "^4",
    "typescript": "^5.7",
    "vitest": "^3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/team-monet/monet-core.git"
  }
}
